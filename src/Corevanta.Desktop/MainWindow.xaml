<Window x:Class="Corevanta.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
        xmlns:local="clr-namespace:Corevanta.Desktop"
        mc:Ignorable="d"
        Title="Corevanta"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        WindowState="Maximized"
        MinHeight="700"
        MinWidth="1200"
        Height="800"
        Width="1320"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DiagramItemContainerStyle" TargetType="{x:Type nodify:ItemContainer}">
            <Setter Property="Location"
                    Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="IsDraggable" Value="{Binding IsDraggable}" />
            <Setter Property="IsSelectable" Value="True" />
            <Setter Property="SelectedBorderThickness" Value="1.2" />
            <Style.Triggers>
                <Trigger Property="IsDraggable" Value="True">
                    <Setter Property="Cursor" Value="SizeAll" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DiagramConnectionTemplate" DataType="{x:Type local:LogicEdge}">
            <Canvas IsHitTestVisible="False">
                <Path Data="{Binding RouteGeometry}"
                      Stroke="#2F2F2F"
                      StrokeThickness="1.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      SnapsToDevicePixels="True" />
                <Polygon Points="0,0 -9,-4.5 -9,4.5"
                         Fill="#2F2F2F"
                         Stroke="#2F2F2F"
                         StrokeThickness="0.8"
                         Canvas.Left="{Binding ArrowPoint.X}"
                         Canvas.Top="{Binding ArrowPoint.Y}">
                    <Polygon.RenderTransform>
                        <RotateTransform Angle="{Binding ArrowAngle}" />
                    </Polygon.RenderTransform>
                </Polygon>
                <Border Background="Transparent"
                        CornerRadius="2"
                        Padding="2,0"
                        Canvas.Left="{Binding LabelPoint.X}"
                        Canvas.Top="{Binding LabelPoint.Y}">
                    <TextBlock Text="{Binding DisplayText}"
                               FontSize="10.5"
                               Foreground="#3A3A3A" />
                </Border>
                <Border Background="Transparent"
                        CornerRadius="2"
                        Padding="2,0"
                        Canvas.Left="{Binding StartLabelPoint.X}"
                        Canvas.Top="{Binding StartLabelPoint.Y}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayStartLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DisplayStartLabel}"
                               FontSize="10"
                               Foreground="#3A3A3A" />
                </Border>
                <Border Background="Transparent"
                        CornerRadius="2"
                        Padding="2,0"
                        Canvas.Left="{Binding EndLabelPoint.X}"
                        Canvas.Top="{Binding EndLabelPoint.Y}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayEndLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DisplayEndLabel}"
                               FontSize="10"
                               Foreground="#3A3A3A" />
                </Border>
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="DiagramNodeTemplate" DataType="{x:Type local:LogicVertex}">
            <Grid x:Name="NodeRoot"
                  Width="{Binding Width}"
                  Height="{Binding Height}"
                  Cursor="Arrow">
                <Border x:Name="RectShape"
                        CornerRadius="6"
                        BorderBrush="#6E6E6E"
                        BorderThickness="1.2"
                        Background="#F6F6F6" />

                <Path x:Name="AndShape"
                      Visibility="Collapsed"
                      Stretch="Fill"
                      Fill="#FFFBEF"
                      Stroke="#555555"
                      StrokeThickness="1.2"
                      Data="M20,10 L98,10 Q160,48 98,86 L20,86 Z" />

                <Path x:Name="OrShape"
                      Visibility="Collapsed"
                      Stretch="Fill"
                      Fill="#FFFBEF"
                      Stroke="#555555"
                      StrokeThickness="1.2"
                      Data="M14,10 Q50,48 14,86 Q90,86 160,48 Q90,10 14,10 Z" />

                <Grid x:Name="NotShape" Visibility="Collapsed">
                    <Viewbox Stretch="Fill" Margin="8,8,8,8">
                        <Canvas Width="180" Height="96">
                            <Polygon Points="26,10 26,86 138,48"
                                     Fill="#FFFBEF"
                                     Stroke="#555555"
                                     StrokeThickness="1.2" />
                            <Ellipse Width="14"
                                     Height="14"
                                     Fill="#FFFBEF"
                                     Stroke="#555555"
                                     StrokeThickness="1.2"
                                     Canvas.Left="146"
                                     Canvas.Top="41" />
                        </Canvas>
                    </Viewbox>
                </Grid>

                <Grid x:Name="PulseShape" Visibility="Collapsed">
                    <Border CornerRadius="4"
                            BorderBrush="#555555"
                            BorderThickness="1.2"
                            Background="#FFFBEF" />
                    <Path Data="M34,66 L34,42 L62,42 L62,26 L92,26 L92,66 L122,66"
                          Stroke="#444444"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Grid>

                <TextBlock x:Name="VertexText"
                           Text="{Binding Title}"
                           Background="Transparent"
                           Foreground="#1E1E1E"
                           FontWeight="SemiBold"
                           FontSize="12"
                           LineHeight="{Binding LineHeight}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="14,10,14,10"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="UpstreamIndicator"
                           Text="{Binding UpstreamIndicatorText}"
                           Visibility="Collapsed"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2B4D66"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />

                <TextBlock x:Name="DownstreamIndicator"
                           Text="{Binding DownstreamIndicatorText}"
                           Visibility="Collapsed"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2B4D66"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <Border x:Name="OpcBadge"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,6,0"
                        Padding="7,1"
                        CornerRadius="9"
                        Background="#E8F4FF"
                        BorderBrush="#7AA7D9"
                        BorderThickness="1">
                    <TextBlock Text="OPCI"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#1E5F99" />
                </Border>

            </Grid>
            <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsDraggable}" Value="True">
                        <Setter TargetName="NodeRoot" Property="Cursor" Value="SizeAll" />
                        <Setter TargetName="RectShape" Property="Cursor" Value="SizeAll" />
                        <Setter TargetName="AndShape" Property="Cursor" Value="SizeAll" />
                        <Setter TargetName="OrShape" Property="Cursor" Value="SizeAll" />
                        <Setter TargetName="NotShape" Property="Cursor" Value="SizeAll" />
                        <Setter TargetName="PulseShape" Property="Cursor" Value="SizeAll" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsClProgram}" Value="True">
                        <Setter TargetName="RectShape" Property="Cursor" Value="SizeAll" />
                        <Setter TargetName="VertexText" Property="Cursor" Value="Hand" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="INPUT">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VertexText" Property="Background" Value="#F0F0F0" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="VertexText" Property="FontWeight" Value="Normal" />
                        <Setter TargetName="VertexText" Property="Margin" Value="4,2,4,2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="NUMERIC">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VertexText" Property="Background" Value="#F0F0F0" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="VertexText" Property="FontWeight" Value="Normal" />
                        <Setter TargetName="VertexText" Property="Margin" Value="4,2,4,2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="REF">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VertexText" Property="Background" Value="#F0F0F0" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="VertexText" Property="FontWeight" Value="Normal" />
                        <Setter TargetName="VertexText" Property="Margin" Value="4,2,4,2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="PLC_REF">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VertexText" Property="Background" Value="#E6F4FF" />
                        <Setter TargetName="VertexText" Property="Foreground" Value="#0A4E8B" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="VertexText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="Margin" Value="8,2,4,2" />
                        <Setter TargetName="VertexText" Property="TextWrapping" Value="NoWrap" />
                        <Setter TargetName="VertexText" Property="TextTrimming" Value="CharacterEllipsis" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="PLC_REF_RIGHT">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VertexText" Property="Background" Value="#E6F4FF" />
                        <Setter TargetName="VertexText" Property="Foreground" Value="#0A4E8B" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="VertexText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="Margin" Value="8,2,4,2" />
                        <Setter TargetName="VertexText" Property="TextWrapping" Value="NoWrap" />
                        <Setter TargetName="VertexText" Property="TextTrimming" Value="CharacterEllipsis" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="PLC_REF_LEFT">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VertexText" Property="Background" Value="#E6F4FF" />
                        <Setter TargetName="VertexText" Property="Foreground" Value="#0A4E8B" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Right" />
                        <Setter TargetName="VertexText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="Margin" Value="4,2,10,2" />
                        <Setter TargetName="VertexText" Property="TextWrapping" Value="NoWrap" />
                        <Setter TargetName="VertexText" Property="TextTrimming" Value="CharacterEllipsis" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="LOGIC_REF">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VertexText" Property="Background" Value="#EEF8EA" />
                        <Setter TargetName="VertexText" Property="Foreground" Value="#2E5E1E" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="VertexText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="Margin" Value="8,2,4,2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="OUTPUT">
                        <Setter TargetName="RectShape" Property="Background" Value="#F1FFF2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="CHART">
                        <Setter TargetName="VertexText" Property="FontSize" Value="11" />
                        <Setter TargetName="VertexText" Property="Margin" Value="24,8,24,8" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Center" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="SOFT_REF">
                        <Setter TargetName="RectShape" Property="Background" Value="#FFF2CC" />
                        <Setter TargetName="RectShape" Property="BorderBrush" Value="#C28E0E" />
                        <Setter TargetName="VertexText" Property="Foreground" Value="#6A4B00" />
                        <Setter TargetName="VertexText" Property="FontSize" Value="11" />
                        <Setter TargetName="VertexText" Property="Margin" Value="8,6,8,6" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Top" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="SOFT_REF_OPCI">
                        <Setter TargetName="RectShape" Property="Background" Value="#FFF2CC" />
                        <Setter TargetName="RectShape" Property="BorderBrush" Value="#C28E0E" />
                        <Setter TargetName="VertexText" Property="Foreground" Value="#6A4B00" />
                        <Setter TargetName="VertexText" Property="FontSize" Value="11" />
                        <Setter TargetName="VertexText" Property="Margin" Value="8,18,8,6" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Top" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Left" />
                        <Setter TargetName="OpcBadge" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="PI_REF">
                        <Setter TargetName="RectShape" Property="Background" Value="#E8F5FF" />
                        <Setter TargetName="RectShape" Property="BorderBrush" Value="#2D7FB8" />
                        <Setter TargetName="VertexText" Property="Foreground" Value="#0B4468" />
                        <Setter TargetName="VertexText" Property="FontSize" Value="11" />
                        <Setter TargetName="VertexText" Property="Margin" Value="8,6,8,6" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Center" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsArrayMappingChart}" Value="True">
                        <Setter TargetName="VertexText" Property="LineStackingStrategy" Value="BlockLineHeight" />
                        <Setter TargetName="VertexText" Property="Margin" Value="8,0,8,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowUpstreamIndicator}" Value="True">
                        <Setter TargetName="UpstreamIndicator" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowDownstreamIndicator}" Value="True">
                        <Setter TargetName="DownstreamIndicator" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_AND">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="AndShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_OR">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="OrShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_NOR">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="OrShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_NAND">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="AndShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_NOT">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="NotShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_NOT_INLINE">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="NotShape" Property="Visibility" Value="Visible" />
                        <Setter TargetName="VertexText" Property="TextAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="VertexText" Property="Margin" Value="14,10,14,10" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_XOR">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="OrShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_XNOR">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="OrShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_PULSE">
                        <Setter TargetName="RectShape" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="PulseShape" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_COMPARE">
                        <Setter TargetName="RectShape" Property="Background" Value="#FFF5E8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_TIMER">
                        <Setter TargetName="RectShape" Property="Background" Value="#EEF7EE" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="GATE_MONITOR">
                        <Setter TargetName="RectShape" Property="Background" Value="#FFEFEF" />
                    </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <TabControl x:Name="MainTabControl"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Import">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Width="90"
                                Padding="10,6"
                                Click="NewProject_Click"
                                Content="New" />
                        <Button Width="90"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="OpenProject_Click"
                                Content="Open..." />
                        <Button Width="90"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="SaveProject_Click"
                                Content="Save" />
                        <Button Width="110"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="ProjectPassword_Click"
                                Content="Password..." />
                        <Button x:Name="LicenseButton"
                                Width="100"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="LicenseActivation_Click"
                                Content="License..." />
                        <Button x:Name="Cv2TestButton"
                                Width="110"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="Cv2ActivationTest_Click"
                                Content="CV2 Test..." />
                        <Button Width="130"
                                Margin="8,0,0,0"
                                Padding="10,6"
                                Click="UndoImport_Click"
                                Content="Undo Import..." />
                        <TextBlock x:Name="ProjectStatusText"
                                    Margin="14,8,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Project: (unsaved working project)" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportEbFiles_Click"
                                Content="Import EB Files..." />
                        <TextBlock x:Name="ImportSummaryText"
                                    Margin="14,8,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="No files imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="IndexClFolder_Click"
                                Content="Import CL Folder..." />
                        <TextBlock x:Name="ClImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No CL folder indexed yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportAbPlcFiles_Click"
                                Content="AB PLC5 Import Files..." />
                        <TextBlock x:Name="AbPlcImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No AB PLC5 files imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportAbLogixFiles_Click"
                                Content="AB Logix Import Files..." />
                        <TextBlock x:Name="AbLogixImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No AB Logix files imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="5"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportModiconFiles_Click"
                                Content="Import Modicon Files..." />
                        <TextBlock x:Name="ModiconImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No Modicon files imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="6"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportSoftConnections_Click"
                                Content="Import Experion Connections..." />
                        <TextBlock x:Name="SoftConnectionsImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No soft connections imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="7"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportOpcIntegratorMappings_Click"
                                Content="OPC Integrator Import..." />
                        <TextBlock x:Name="OpcIntegratorImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No OPC Integrator mappings imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="8"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportGraphicsPoints_Click"
                                Content="HMIWeb Graphics Import..." />
                        <TextBlock x:Name="GraphicsPointsImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No HMIWeb graphics imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="9"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button Width="200"
                                Padding="10,6"
                                Click="ImportPiMappings_Click"
                                Content="PI Import..." />
                        <TextBlock x:Name="PiImportSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No PI mappings imported yet." />
                    </StackPanel>

                    <StackPanel Grid.Row="10"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Button x:Name="ExportPointDetailsButton"
                                Width="200"
                                Padding="10,6"
                                Click="ExportPointDetailsExcel_Click"
                                Content="Export Point Details..." />
                        <TextBlock x:Name="ExportPointsSummaryText"
                                   Margin="14,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No point export run yet." />
                    </StackPanel>

                    <TextBlock Grid.Row="11"
                               Margin="0,12,0,8"
                               FontSize="12"
                               Foreground="#555555"
                               Text="Import log:" />

                    <ListBox x:Name="ImportLogList"
                             Grid.Row="12"
                             FontFamily="Consolas"
                             FontSize="13" />
                </Grid>
            </TabItem>

            <TabItem Header="Detail">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal">
                        <TextBox x:Name="SearchTextBox"
                                 Width="360"
