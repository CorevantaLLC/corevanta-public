                                    <DataGridTextColumn Width="*"
                                                        Binding="{Binding Description}"
                                                        Header="Description" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Grid.Row="6"
                                   Margin="0,0,0,4"
                                   FontWeight="SemiBold"
                                   Foreground="#555555"
                                   Text="PLC Linked DCS Points" />

                        <Border Grid.Row="7"
                                Margin="0,0,0,0"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1">
                            <DataGrid x:Name="HardwarePlcPointsGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      GridLinesVisibility="All"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="220"
                                                        Binding="{Binding Name}"
                                                        Header="Point" />
                                    <DataGridTextColumn Width="220"
                                                        Binding="{Binding TagName}"
                                                        Header="Tag" />
                                    <DataGridTextColumn Width="80"
                                                        Binding="{Binding Channel}"
                                                        Header="Channel" />
                                    <DataGridTextColumn Width="90"
                                                        Binding="{Binding RegisterAddress}"
                                                        Header="Register" />
                                    <DataGridTextColumn Width="220"
                                                        Binding="{Binding RegisterDescription}"
                                                        Header="Reg Description" />
                                    <DataGridTextColumn Width="180"
                                                        Binding="{Binding Location}"
                                                        Header="Location" />
                                    <DataGridTemplateColumn Width="90" Header="Chart">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Hyperlink Click="HardwarePointChartLink_Click" Tag="{Binding EntityId}">
                                                        <Run Text="Open" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="90" Header="Detail">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Hyperlink Click="HardwarePointDetailLink_Click" Tag="{Binding EntityId}">
                                                        <Run Text="Open" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="AB">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal">
                        <TextBox x:Name="AbPlcSearchTextBox"
                                 Width="260"
                                 Margin="0,0,8,0"
                                 Padding="8,5"
                                 KeyDown="AbPlcSearchTextBox_KeyDown"
                                 ToolTip="Search AB import name, connection type, HWY/BOX, or file" />
                        <Button Width="90"
                                Padding="10,5"
                                Click="SearchAbPlcButton_Click"
                                Content="Search" />
                        <TextBlock x:Name="AbPlcSummaryText"
                                   Margin="8,7,0,0"
                                   Foreground="#555555"
                                   Text="No AB import search run yet."
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="AbPlcSystemsList"
                                 SelectionChanged="AbPlcSystemsList_SelectionChanged"
                                 DisplayMemberPath="DisplayLabel" />

                        <TextBlock x:Name="AbPlcHeaderText"
                                   Grid.Row="1"
                                   Margin="0,8,0,6"
                                   Foreground="#555555"
                                   Text="Select an AB import to view ladder files." />

                        <ListBox x:Name="AbPlcFilesList"
                                 Grid.Row="2"
                                 SelectionMode="Extended"
                                 SelectionChanged="AbPlcFilesList_SelectionChanged"
                                 DisplayMemberPath="FileName" />
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="AbPlcViewerHeaderText"
                                   FontWeight="SemiBold"
                                   Text="Select one or more XPS files to view ladder logic." />

                                                <StackPanel Grid.Row="1"
                                    Margin="0,6,0,2"
                                    Orientation="Horizontal">
                            <TextBox x:Name="AbPlcXpsSearchBox"
                                     Width="200"
                                     Padding="6,4"
                                     KeyDown="AbPlcXpsSearchBox_KeyDown"
                                     ToolTip="Enter full address (for example N22:44/10) to jump to the first mapped reference." />
                            <Button Width="120"
                                    Margin="6,0,0,0"
                                    Padding="8,4"
                                    Click="AbPlcXpsGoRefButton_Click"
                                    Content="Address Search" />
                            <Button Width="160"
                                    Margin="6,0,0,0"
                                    Padding="8,4"
                                    Click="AbPlcXpsFindButton_Click"
                                    Content="Open Find (Ctrl+F)" />
                            <Button x:Name="AbPlcXpsPrevButton"
                                    Width="60"
                                    Margin="6,0,0,0"
                                    Padding="8,4"
                                    Click="AbPlcXpsPrevButton_Click"
                                    Content="Prev"
                                    IsEnabled="False" />
                            <Button x:Name="AbPlcXpsNextButton"
                                    Width="60"
                                    Margin="4,0,0,0"
                                    Padding="8,4"
                                    Click="AbPlcXpsNextButton_Click"
                                    Content="Next"
                                    IsEnabled="False" />
                            <TextBlock x:Name="AbPlcXpsSearchStatusText"
                                       Margin="10,6,0,0"
                                       Foreground="#555555" />
                        </StackPanel>

                        <Border Grid.Row="2"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1">
                            <DocumentViewer x:Name="AbPlcXpsViewer" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Modicon">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal">
                        <TextBox x:Name="ModiconSearchTextBox"
                                 Width="260"
                                 Margin="0,0,8,0"
                                 Padding="8,5"
                                 KeyDown="ModiconSearchTextBox_KeyDown"
                                 ToolTip="Search Modicon PLC name, connection type, HWY/BOX, registers file, or PLC mapping file" />
                        <Button Width="90"
                                Padding="10,5"
                                Click="SearchModiconButton_Click"
                                Content="Search" />
                        <Button Width="190"
                                Margin="8,0,0,0"
                                Padding="10,5"
                                Click="ImportModiconFiles_Click"
                                Content="Import Modicon Files..." />
                        <TextBlock x:Name="ModiconSummaryText"
                                   Margin="12,7,0,0"
                                   Foreground="#555555"
                                   Text="No Modicon search run yet." />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="ModiconSystemsList"
                                 SelectionChanged="ModiconSystemsList_SelectionChanged"
                                 DisplayMemberPath="DisplayLabel" />

                        <TextBlock x:Name="ModiconHeaderText"
                                   Grid.Row="1"
                                   Margin="0,8,0,6"
                                   Foreground="#555555"
                                   Text="Select a Modicon PLC to view program files." />

                        <ListBox x:Name="ModiconFilesList"
                                 Grid.Row="2"
                                 SelectionMode="Extended"
                                 SelectionChanged="ModiconFilesList_SelectionChanged"
                                 DisplayMemberPath="FileName" />
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ModiconViewerHeaderText"
                                   FontWeight="SemiBold"
                                   Text="Select one or more XPS files to view ladder logic." />

                                                <StackPanel Grid.Row="1"
                                    Margin="0,6,0,2"
                                    Orientation="Horizontal">
                            <TextBox x:Name="ModiconXpsSearchBox"
                                     Width="200"
                                     Padding="6,4"
                                     KeyDown="ModiconXpsSearchBox_KeyDown"
                                     ToolTip="Enter full address (for example N22:44/10) to jump to the first mapped reference." />
                            <Button Width="120"
                                    Margin="6,0,0,0"
                                    Padding="8,4"
                                    Click="ModiconXpsGoRefButton_Click"
                                    Content="Address Search" />
                            <Button Width="160"
                                    Margin="6,0,0,0"
                                    Padding="8,4"
                                    Click="ModiconXpsFindButton_Click"
                                    Content="Open Find (Ctrl+F)" />
                            <Button x:Name="ModiconXpsPrevButton"
                                    Width="60"
                                    Margin="6,0,0,0"
                                    Padding="8,4"
                                    Click="ModiconXpsPrevButton_Click"
                                    Content="Prev"
                                    IsEnabled="False" />
                            <Button x:Name="ModiconXpsNextButton"
                                    Width="60"
                                    Margin="4,0,0,0"
                                    Padding="8,4"
                                    Click="ModiconXpsNextButton_Click"
                                    Content="Next"
                                    IsEnabled="False" />
                            <TextBlock x:Name="ModiconXpsSearchStatusText"
                                       Margin="10,6,0,0"
                                       Foreground="#555555" />
                        </StackPanel>

                        <Border Grid.Row="2"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1">
                            <DocumentViewer x:Name="ModiconXpsViewer" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Change Management">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Width="100"
                                Padding="10,6"
                                Click="RefreshChangeManagement_Click"
                                Content="Refresh" />
                        <TextBlock x:Name="ChangeManagementSummaryText"
                                   Margin="12,8,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="No EB import comparison has been run yet." />
                    </StackPanel>

                    <DataGrid x:Name="ChangeManagementGrid"
                              Grid.Row="1"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="True"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Import Date"
                                                Width="180"
                                                Binding="{Binding ImportedAtLocalText}" />
                            <DataGridTextColumn Header="Change"
                                                Width="110"
                                                Binding="{Binding ChangeType}" />
                            <DataGridTextColumn Header="Entity"
                                                Width="260"
                                                Binding="{Binding EntityName}" />
                            <DataGridTextColumn Header="Type"
                                                Width="140"
                                                Binding="{Binding EntityType}" />
                            <DataGridTextColumn Header="Details"
                                                Width="*"
                                                Binding="{Binding Details}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="TextTrimming" Value="None" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Padding" Value="2,2,2,2" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
